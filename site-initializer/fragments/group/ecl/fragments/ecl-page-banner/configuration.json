                            {"value": "highlighted",  "label": "Highlighted (yellow stripe)"}
                        ]
                    }
                },
                {"defaultValue": "true", "label": "Show eyebrow",      "name": "showEyebrow", "type": "checkbox"},
                {"defaultValue": "true", "label": "Show description",  "name": "showDesc",    "type": "checkbox"},
                {"defaultValue": "true", "label": "Show primary CTA",  "name": "showCta",     "type": "checkbox"},
                {"defaultValue": "false", "label": "Show secondary CTA","name": "showCta2",   "type": "checkbox"}
            ]
        }
    ]
}
