                    }
                },
                {"defaultValue": "true",  "label": "Show image",     "name": "showImage",   "type": "checkbox"},
                {"defaultValue": "true",  "label": "Show meta line", "name": "showMeta",    "type": "checkbox"},
                {"defaultValue": "true",  "label": "Show heading",   "name": "showHeading", "type": "checkbox"},
                {"defaultValue": "true",  "label": "Show text",      "name": "showText",    "type": "checkbox"},
                {"defaultValue": "true",  "label": "Show link",      "name": "showLink",    "type": "checkbox"}
            ]
        }
    ]
